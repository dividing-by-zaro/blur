// Template for Config/Secrets.xcconfig — copy it before generating the project:
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Secrets.xcconfig is gitignored because it can identify your Apple Developer
// account. The app and widget bundle identifiers are fixed in project.yml.

// Your 10-character Apple Developer Team ID, from the membership page at
// developer.apple.com, or Xcode > Settings > Accounts.
//
// Leave it empty to let Xcode pick a team from the signed-in account.
DEVELOPMENT_TEAM =
